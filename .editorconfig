# Shared editor settings. Kept in step with the platform formatters, not
# competing with them: whatever a formatter enforces, it wins.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true

[*.{js,jsx,ts,tsx,json,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
